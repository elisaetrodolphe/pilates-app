<!doctype html>
<html lang="fr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover"><title>Pilates — Gestion des séances</title>
<style>
:root{color-scheme:light dark;--bg:#f7f7f5;--surface:#fff;--surface2:#f0efed;--text:#2c2c2b;--muted:#716f6b;--border:#deddd9;--blue:#2783de;--bluebg:#e5f2fc;--green:#2f8a5e;--greenbg:#e8f1ec;--red:#c94f45;--redbg:#fce9e7;--shadow:0 1px 2px rgba(0,0,0,.05),0 4px 12px rgba(0,0,0,.04)}
@media(prefers-color-scheme:dark){:root{--bg:#191919;--surface:#202020;--surface2:#2b2b2a;--text:#fff;--muted:rgba(255,255,255,.65);--border:rgba(255,255,255,.2);--blue:#5e9fe8;--bluebg:rgba(94,159,232,.13);--green:#72bc8f;--greenbg:rgba(114,188,143,.13);--red:#e97366;--redbg:rgba(233,115,102,.13);--shadow:none}}
*{box-sizing:border-box}html,body{max-width:100%;overflow-x:hidden}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.45 system-ui,-apple-system,"Segoe UI",sans-serif}button,select,input{font:inherit;color:inherit}button,select,input{min-height:44px}.shell{max-width:1000px;margin:auto;padding:28px 24px 100px}.top{display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-bottom:28px}.eyebrow{margin:0 0 4px;color:var(--green);font-size:14px;font-weight:750;letter-spacing:.04em;text-transform:uppercase}.top h1{font-size:clamp(28px,5vw,42px);line-height:1.1;margin:0}.subtitle{color:var(--muted);margin:8px 0 0}.week-controls{display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:flex-end}.week{display:block;background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:0 12px;box-shadow:var(--shadow)}select{background:transparent;border:0;outline:none}.tabs{display:flex;gap:8px;margin-bottom:20px;overflow:auto}.tab,.button{border:1px solid var(--border);background:var(--surface);border-radius:8px;padding:0 16px;cursor:pointer;white-space:nowrap}.tab[aria-selected=true]{background:var(--text);color:var(--surface);border-color:var(--text)}.primary{background:var(--blue);border-color:var(--blue);color:#fff}.danger{color:var(--red)}.small{min-height:38px;padding:0 12px;font-size:14px}.panel{display:none}.panel.active{display:block}.session-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.session{border:1px solid var(--border);border-radius:12px;background:var(--surface);padding:20px;text-align:left;cursor:pointer;box-shadow:var(--shadow);min-height:150px}.session.active{box-shadow:0 0 0 2px var(--blue);border-color:var(--blue)}.session-day{font-size:22px;font-weight:750}.session-time{color:var(--muted);margin:2px 0 24px}.progress{height:6px;border-radius:99px;background:var(--surface2);overflow:hidden}.progress i{display:block;height:100%;background:var(--green)}.session-meta{display:flex;justify-content:space-between;margin-top:8px;font-size:14px;color:var(--muted)}.card{margin-top:20px;border:1px solid var(--border);background:var(--surface);border-radius:12px;box-shadow:var(--shadow);overflow:hidden}.card:first-child{margin-top:0}.card-head{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 22px;border-bottom:1px solid var(--border)}.card-head h2{font-size:20px;margin:0}.card-head p{margin:2px 0 0;color:var(--muted);font-size:14px}.person{display:grid;grid-template-columns:44px 1fr auto;align-items:center;gap:14px;padding:14px 22px;border-bottom:1px solid var(--border)}.person:last-child,.row:last-child{border-bottom:0}.avatar{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;background:var(--bluebg);color:var(--blue);font-weight:750}.name{font-weight:650}.muted{color:var(--muted);font-size:14px}.check{border:1px solid var(--border);background:transparent;border-radius:8px;min-width:112px;padding:0 14px;cursor:pointer;font-weight:650}.check.present{background:var(--greenbg);color:var(--green);border-color:var(--green)}.check.absent{background:var(--redbg);color:var(--red);border-color:var(--red)}.notice{margin-top:18px;padding:14px 16px;border-radius:8px;background:var(--bluebg);color:var(--blue);font-size:14px}.profile-select{width:100%;border:1px solid var(--border);border-radius:8px;background:var(--surface2);padding:0 12px}.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:18px}.metric{padding:20px;border:1px solid var(--border);border-radius:12px;background:var(--surface)}.metric b{font-size:30px;display:block}.metric span{color:var(--muted)}.metric.highlight{background:var(--greenbg);border-color:var(--green)}.metric.highlight b,.metric.highlight span{color:var(--green)}.row{display:grid;grid-template-columns:1.2fr 1fr auto;gap:14px;align-items:center;padding:15px 20px;border-bottom:1px solid var(--border)}.date-row{display:grid;grid-template-columns:1fr 1fr auto;gap:12px;align-items:center;padding:15px 20px;border-bottom:1px solid var(--border)}.badge{padding:4px 9px;border-radius:999px;background:var(--greenbg);color:var(--green);font-weight:700;font-size:13px}.actions{display:flex;gap:8px;justify-content:flex-end}.backup-actions{justify-content:flex-start;flex-wrap:wrap}.empty{padding:30px;text-align:center;color:var(--muted)}dialog{border:1px solid var(--border);border-radius:12px;background:var(--surface);color:var(--text);padding:0;width:min(92vw,480px);box-shadow:0 18px 60px rgba(0,0,0,.22)}dialog::backdrop{background:rgba(0,0,0,.35)}.modal-head{padding:20px 22px;border-bottom:1px solid var(--border)}.modal-head h2{margin:0;font-size:21px}.form{padding:20px 22px}.field{display:block;margin-bottom:16px}.field span{display:block;font-size:14px;font-weight:650;margin-bottom:6px}.field input,.field select{width:100%;border:1px solid var(--border);border-radius:8px;background:var(--surface2);padding:0 12px}.modal-actions{display:flex;justify-content:flex-end;gap:8px;padding-top:4px}
@media(max-width:680px){.shell{padding:20px 16px 90px}.top{display:block}.week-controls{margin-top:18px;justify-content:stretch}.week-controls .week{flex:1;min-width:0}.week-controls .button{flex:0 0 auto}.week select{width:100%}.session-grid{grid-template-columns:1fr}.session{min-height:auto}.tabs{padding-bottom:2px;gap:6px}.tab{padding:0 11px;font-size:15px}.card-head{align-items:flex-start}.person{padding:14px 16px;grid-template-columns:40px 1fr}.avatar{width:40px;height:40px}.check{grid-column:1/-1;width:100%}.summary{grid-template-columns:1fr}.row{grid-template-columns:1fr}.date-row{grid-template-columns:1fr auto}.date-row>:nth-child(2){grid-row:2}.actions{justify-content:flex-start}.backup-actions{display:grid;grid-template-columns:1fr}.backup-actions .button{width:100%}.top h1{font-size:32px}}
:focus-visible{outline:3px solid var(--blue);outline-offset:2px}
</style></head><body><main class="shell">
<header class="top"><div><p class="eyebrow">Gestion des présences</p><h1>Pilates · Pointage</h1><p class="subtitle">Prototype enrichi · données enregistrées sur cet appareil</p></div><div class="week-controls"><label class="week"><span style="position:absolute;clip:rect(0 0 0 0)">Semaine</span><select id="week"></select></label><button class="button small" id="addWeek" type="button">+ Semaine</button><button class="button small danger" id="deleteWeek" type="button">Supprimer</button></div></header>
<nav class="tabs"><button class="tab" aria-selected="true" data-tab="checkin">Pointage</button><button class="tab" aria-selected="false" data-tab="tracking">Suivi individuel</button><button class="tab" aria-selected="false" data-tab="settings">Réglages</button></nav>
<section id="checkin" class="panel active"><div id="sessionsGrid" class="session-grid"></div><div class="card"><div class="card-head"><div><h2 id="listTitle">Participants</h2><p id="listMeta"></p></div><div class="actions"><button class="button small" id="addException" type="button">+ Participant exceptionnel</button><button class="button small" id="clearWeek">Réinitialiser</button></div></div><div id="peopleList"></div></div><div class="notice">Un participant peut rattraper une séance dans un autre créneau. Ajoutez-le comme « participant exceptionnel » : sa présence sera décomptée de son forfait, sans modifier sa séance habituelle.</div></section>
<section id="tracking" class="panel"><div class="card"><div class="card-head"><div><h2>Fiche participant</h2><p>Forfait, solde et dates de présence</p></div></div><div style="padding:20px"><select id="profileSelect" class="profile-select"></select><div id="profileSummary" class="summary"></div></div><div id="profileDates"></div></div></section>
<section id="settings" class="panel"><div class="card"><div class="card-head"><div><h2>Participants</h2><p>Ajoutez, modifiez ou supprimez un compte</p></div><button class="button primary small" id="addPerson">Ajouter</button></div><div id="managePeople"></div></div><div class="card"><div class="card-head"><div><h2>Séances hebdomadaires</h2><p>Modifiez les jours et horaires</p></div><button class="button primary small" id="addSession">Ajouter</button></div><div id="manageSessions"></div></div><div class="card"><div class="card-head"><div><h2>Sauvegarde</h2><p>Transférez vos données entre ordinateur, tablette et mobile.</p></div></div><div style="padding:20px"><div class="actions backup-actions"><button class="button primary" id="exportData" type="button">Exporter mes données</button><button class="button" id="importData" type="button">Importer une sauvegarde</button><input id="importFile" type="file" accept=".json,application/json" hidden></div><div class="notice">L’export crée un petit fichier <strong>.json</strong>. Gardez-le précieusement : vous pourrez l’importer sur un autre appareil.</div></div></div></section>
</main>
<dialog id="exceptionDialog"><div class="modal-head"><h2>Ajouter un participant exceptionnel</h2></div><form method="dialog" class="form" id="exceptionForm"><label class="field"><span>Participant</span><select id="exceptionPerson" required></select></label><div class="notice">Cette personne sera ajoutée uniquement à la séance et à la semaine actuellement sélectionnées. Son créneau habituel ne sera pas modifié.</div><div class="modal-actions"><button class="button" value="cancel">Annuler</button><button class="button primary" value="default">Ajouter</button></div></form></dialog><dialog id="personDialog"><div class="modal-head"><h2 id="personDialogTitle">Ajouter un participant</h2></div><form method="dialog" class="form" id="personForm"><input type="hidden" id="personId"><label class="field"><span>Nom et prénom</span><input id="personName" required maxlength="60"></label><label class="field"><span>Séance habituelle</span><select id="personSession" required></select></label><label class="field"><span>Nombre de séances du forfait</span><input id="personCredits" type="number" min="0" max="999" value="10" required></label><div class="modal-actions"><button class="button" value="cancel">Annuler</button><button class="button primary" value="default" id="savePerson">Enregistrer</button></div></form></dialog>
<dialog id="sessionDialog"><div class="modal-head"><h2 id="sessionDialogTitle">Ajouter une séance</h2></div><form method="dialog" class="form" id="sessionForm"><input type="hidden" id="sessionId"><label class="field"><span>Jour</span><select id="sessionDay"><option value="0">Lundi</option><option value="1">Mardi</option><option value="2">Mercredi</option><option value="3">Jeudi</option><option value="4">Vendredi</option><option value="5">Samedi</option><option value="6">Dimanche</option></select></label><label class="field"><span>Horaire</span><input id="sessionTime" type="time" required value="18:00"></label><label class="field"><span>Capacité maximale</span><input id="sessionCapacity" type="number" min="1" max="100" value="12"></label><div class="modal-actions"><button class="button" value="cancel">Annuler</button><button class="button primary" value="default" id="saveSession">Enregistrer</button></div></form></dialog>
<script>
const days=['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi','Dimanche'];
const defaultsS=[{id:'lun',dayIndex:0,time:'18:00',capacity:12},{id:'mer',dayIndex:2,time:'12:30',capacity:12},{id:'sam',dayIndex:5,time:'10:00',capacity:12}];
const defaultsP=[{id:1,name:'Alice Martin',session:'lun',credits:10},{id:2,name:'Bruno Durand',session:'lun',credits:10},{id:3,name:'Chloé Petit',session:'mer',credits:12},{id:4,name:'David Leroy',session:'sam',credits:8},{id:5,name:'Emma Garcia',session:'mer',credits:10}];
let sessions=JSON.parse(localStorage.getItem('pilates-sessions')||'null')||defaultsS;let people=JSON.parse(localStorage.getItem('pilates-people')||'null')||defaultsP;let attendance=JSON.parse(localStorage.getItem('pilates-attendance')||'{}');
sessions=sessions.map((s,i)=>({...s,dayIndex:s.dayIndex??[0,2,5][i]??0,time:(s.time||'18:00').replace(' h ',':'),capacity:Number(s.capacity||12)}));people=people.map(p=>({...p,credits:Number.isFinite(+p.credits)?+p.credits:10}));let active=sessions[0]?.id||null;
const $=id=>document.getElementById(id);function save(){localStorage.setItem('pilates-sessions',JSON.stringify(sessions));localStorage.setItem('pilates-people',JSON.stringify(people));localStorage.setItem('pilates-attendance',JSON.stringify(attendance))}
function monday(d=new Date()){let x=new Date(d),n=(x.getDay()+6)%7;x.setDate(x.getDate()-n);x.setHours(12,0,0,0);return x}const base=monday();const iso=d=>d.toISOString().slice(0,10);const fmt=d=>new Intl.DateTimeFormat('fr-FR',{day:'numeric',month:'short',year:'numeric'}).format(d);const weekStore='pilates-weeks';let weeks=JSON.parse(localStorage.getItem(weekStore)||'null');if(!Array.isArray(weeks)||!weeks.length){weeks=[];for(let n=-8;n<=4;n++){let d=new Date(base);d.setDate(d.getDate()+n*7);weeks.push(iso(d))}localStorage.setItem(weekStore,JSON.stringify(weeks))}weeks=[...new Set(weeks)].sort();let selectedWeek=weeks.includes(iso(base))?iso(base):weeks[0];function renderWeeks(){weeks.sort();if(!weeks.includes(selectedWeek))selectedWeek=weeks[0];$('week').innerHTML=weeks.map(w=>`<option value="${w}" ${w===selectedWeek?'selected':''}>Semaine du ${fmt(new Date(w+'T12:00:00'))}</option>`).join('');$('deleteWeek').disabled=weeks.length<=1}function persistWeeks(){localStorage.setItem(weekStore,JSON.stringify(weeks));renderWeeks()}renderWeeks();
const key=(sid,pid,w=$('week').value)=>`${w}|${sid}|${pid}`;const prettyTime=t=>t.replace(':',' h ');const initials=n=>n.split(' ').map(x=>x[0]).join('').slice(0,2).toUpperCase();const esc=s=>String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
function used(pid){return Object.keys(attendance).filter(k=>k.endsWith('|'+pid)&&attendance[k]==='present').length}function remaining(p){return Math.max(0,p.credits-used(p.id))}function sessionName(s){return `${days[s.dayIndex]} · ${prettyTime(s.time)}`}
function attendanceDate(k){let [w,sid]=k.split('|'),s=sessions.find(x=>x.id===sid),d=new Date(w+'T12:00:00');d.setDate(d.getDate()+(s?.dayIndex||0));return d}
function renderSessions(){if(!sessions.length){$('sessionsGrid').innerHTML='<div class="empty">Ajoutez une séance dans les réglages.</div>';return}if(!sessions.some(s=>s.id===active))active=sessions[0].id;$('sessionsGrid').innerHTML=sessions.sort((a,b)=>a.dayIndex-b.dayIndex||a.time.localeCompare(b.time)).map(s=>{let ps=people.filter(p=>p.session===s.id),occupied=ps.filter(p=>attendance[key(s.id,p.id)]==='present').length,done=ps.filter(p=>attendance[key(s.id,p.id)]).length,pct=(s.capacity||12)?100*occupied/(s.capacity||12):0;return `<button class="session ${active===s.id?'active':''}" data-session="${s.id}"><div class="session-day">${days[s.dayIndex]}</div><div class="session-time">${prettyTime(s.time)}</div><div class="progress"><i style="width:${pct}%"></i></div><div class="session-meta"><span>${occupied}/${s.capacity||12} places occupées</span><span>${done}/${ps.length} pointé${done>1?'s':''}</span></div></button>`}).join('');document.querySelectorAll('[data-session]').forEach(b=>b.onclick=()=>{active=b.dataset.session;render()})}
function renderPointing(){let s=sessions.find(x=>x.id===active);if(!s){$('listTitle').textContent='Aucune séance';$('listMeta').textContent='';$('peopleList').innerHTML='<div class="empty">Créez votre première séance.</div>';return}let regular=people.filter(p=>p.session===active);let exceptionalIds=Object.keys(attendance).filter(k=>k.startsWith($('week').value+'|'+active+'|')).map(k=>+k.split('|')[2]);let exceptional=people.filter(p=>exceptionalIds.includes(p.id)&&p.session!==active);let ps=[...regular,...exceptional];$('listTitle').textContent=sessionName(s);$('listMeta').textContent=`${ps.length} participant${ps.length>1?'s':''} · ${exceptional.length} exceptionnel${exceptional.length>1?'s':''}`;$('peopleList').innerHTML=ps.length?ps.map(p=>{let v=attendance[key(active,p.id)]||'',label=v==='present'?'Présent':v==='absent'?'Absent':v==='exceptional'?'À pointer':'À pointer',isExceptional=p.session!==active;return `<div class="person"><div class="avatar">${initials(p.name)}</div><div><div class="name">${esc(p.name)} ${isExceptional?'<span class="badge">Rattrapage</span>':''}</div><div class="muted">${remaining(p)} séance${remaining(p)>1?'s':''} restante${remaining(p)>1?'s':''}${isExceptional?' · séance exceptionnelle':''}</div></div><button class="check ${v}" data-check="${p.id}">${label}</button></div>`}).join(''):'<div class="empty">Aucun participant inscrit à cette séance.</div>';document.querySelectorAll('[data-check]').forEach(b=>b.onclick=()=>{let k=key(active,+b.dataset.check),v=attendance[k];attendance[k]=!v?'present':v==='exceptional'?'present':v==='present'?'absent':'';if(!attendance[k])delete attendance[k];save();render()})}
function renderTracking(){let current=+$('profileSelect').value||people[0]?.id;$('profileSelect').innerHTML=people.length?people.map(p=>`<option value="${p.id}" ${p.id===current?'selected':''}>${esc(p.name)}</option>`).join(''):'<option>Aucun participant</option>';let p=people.find(x=>x.id===current)||people[0];if(!p){$('profileSummary').innerHTML='';$('profileDates').innerHTML='<div class="empty">Ajoutez un participant pour afficher son suivi.</div>';return}$('profileSelect').value=p.id;let keys=Object.keys(attendance).filter(k=>k.endsWith('|'+p.id)&&attendance[k]==='present').sort((a,b)=>attendanceDate(b)-attendanceDate(a));$('profileSummary').innerHTML=`<div class="metric highlight"><b>${remaining(p)}</b><span>séances restantes</span></div><div class="metric"><b>${used(p.id)}</b><span>séances suivies</span></div><div class="metric"><b>${p.credits}</b><span>séances dans le forfait</span></div>`;$('profileDates').innerHTML=keys.length?`<div class="card-head"><div><h2>Dates des séances</h2><p>${keys.length} présence${keys.length>1?'s':''} enregistrée${keys.length>1?'s':''}</p></div></div>`+keys.map(k=>{let s=sessions.find(x=>x.id===k.split('|')[1]),d=attendanceDate(k);return `<div class="date-row"><strong>${fmt(d)}</strong><span class="muted">${s?sessionName(s):'Séance supprimée'}</span><span class="badge">Présent</span></div>`}).join(''):'<div class="empty">Aucune présence enregistrée.</div>'}
function renderSettings(){$('managePeople').innerHTML=people.length?people.map(p=>`<div class="row"><div><strong>${esc(p.name)}</strong><div class="muted">${remaining(p)} restante${remaining(p)>1?'s':''} sur ${p.credits}</div></div><span>${sessionName(sessions.find(s=>s.id===p.session)||{dayIndex:0,time:'--:--'})}</span><div class="actions"><button class="button small" data-edit-p="${p.id}">Modifier</button><button class="button small danger" data-del-p="${p.id}">Supprimer</button></div></div>`).join(''):'<div class="empty">Aucun participant.</div>';$('manageSessions').innerHTML=sessions.length?sessions.map(s=>`<div class="row"><div><strong>${days[s.dayIndex]}</strong><div class="muted">${prettyTime(s.time)} · Capacité : ${s.capacity||12}</div></div><span>${people.filter(p=>p.session===s.id).length} inscrit${people.filter(p=>p.session===s.id).length>1?'s':''}</span><div class="actions"><button class="button small" data-edit-s="${s.id}">Modifier</button><button class="button small danger" data-del-s="${s.id}">Supprimer</button></div></div>`).join(''):'<div class="empty">Aucune séance.</div>';document.querySelectorAll('[data-edit-p]').forEach(b=>b.onclick=()=>openPerson(+b.dataset.editP));document.querySelectorAll('[data-del-p]').forEach(b=>b.onclick=()=>deletePerson(+b.dataset.delP));document.querySelectorAll('[data-edit-s]').forEach(b=>b.onclick=()=>openSession(b.dataset.editS));document.querySelectorAll('[data-del-s]').forEach(b=>b.onclick=()=>deleteSession(b.dataset.delS))}
function fillSessionOptions(selected){$('personSession').innerHTML=sessions.map(s=>`<option value="${s.id}" ${s.id===selected?'selected':''}>${sessionName(s)}</option>`).join('')}
function openDialog(dialog){if(dialog.showModal){dialog.showModal();}else{dialog.setAttribute('open','open');dialog.style.display='block';}}function closeDialog(dialog){if(dialog.close){dialog.close();}else{dialog.removeAttribute('open');dialog.style.display='none';}}function openException(){let s=sessions.find(x=>x.id===active);if(!s)return alert('Créez d’abord une séance.');let week=$('week').value;let already=Object.keys(attendance).filter(k=>k.startsWith(week+'|'+active+'|')).map(k=>+k.split('|')[2]);let available=people.filter(p=>p.session!==active&&!already.includes(p.id));$('exceptionPerson').innerHTML=available.length?available.map(p=>`<option value="${p.id}">${esc(p.name)} · ${remaining(p)} restante${remaining(p)>1?'s':''}</option>`).join(''):'<option value="">Aucun participant disponible</option>';openDialog($('exceptionDialog'));$('exceptionPerson').disabled=!available.length}function openPerson(id){if(!sessions.length)return alert('Créez d’abord une séance.');let p=people.find(x=>x.id===id);$('personDialogTitle').textContent=p?'Modifier le participant':'Ajouter un participant';$('personId').value=p?.id||'';$('personName').value=p?.name||'';$('personCredits').value=p?.credits??10;fillSessionOptions(p?.session||sessions[0].id);openDialog($('personDialog'))}
function openSession(id){let s=sessions.find(x=>x.id===id);$('sessionDialogTitle').textContent=s?'Modifier la séance':'Ajouter une séance';$('sessionId').value=s?.id||'';$('sessionDay').value=s?.dayIndex??0;$('sessionTime').value=s?.time||'18:00';$('sessionCapacity').value=s?.capacity||12;openDialog($('sessionDialog'))}
function deletePerson(id){let p=people.find(x=>x.id===id);if(confirm(`Supprimer ${p.name} et tout son historique ?`)){people=people.filter(x=>x.id!==id);Object.keys(attendance).filter(k=>k.endsWith('|'+id)).forEach(k=>delete attendance[k]);save();render()}}
function deleteSession(id){let s=sessions.find(x=>x.id===id),n=people.filter(p=>p.session===id).length;if(n)return alert(`Déplacez d’abord les ${n} participant${n>1?'s':''} inscrit${n>1?'s':''} à cette séance.`);if(confirm(`Supprimer la séance du ${days[s.dayIndex]} ? Son historique sera également supprimé.`)){sessions=sessions.filter(x=>x.id!==id);Object.keys(attendance).filter(k=>k.split('|')[1]===id).forEach(k=>delete attendance[k]);active=sessions[0]?.id||null;save();render()}}
$('personForm').addEventListener('submit',e=>{const submitter=(e.submitter||document.activeElement);if(submitter&&submitter.value==='cancel')return;let id=+$('personId').value,name=$('personName').value.trim(),credits=+$('personCredits').value;if(!name){e.preventDefault();return}if(id){Object.assign(people.find(p=>p.id===id),{name,session:$('personSession').value,credits})}else people.push({id:Date.now(),name,session:$('personSession').value,credits});save();render()});$('sessionForm').addEventListener('submit',e=>{const submitter=(e.submitter||document.activeElement);if(submitter&&submitter.value==='cancel')return;let id=$('sessionId').value,data={dayIndex:+$('sessionDay').value,time:$('sessionTime').value,capacity:+$('sessionCapacity').value||12};if(id)Object.assign(sessions.find(s=>s.id===id),data);else sessions.push({id:'s'+Date.now(),...data});save();render()});
$('exportData').onclick=()=>{const data={app:'pilates-pointage',version:1,exportedAt:new Date().toISOString(),sessions,people,attendance,weeks,selectedWeek};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=`pilates-sauvegarde-${iso(new Date())}.json`;document.body.appendChild(a);a.click();a.remove();URL.revokeObjectURL(url)};$('importData').onclick=()=>$('importFile').click();$('importFile').onchange=e=>{const file=e.target.files?.[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{try{const data=JSON.parse(reader.result);if(data?.app!=='pilates-pointage'||!Array.isArray(data.sessions)||!Array.isArray(data.people)||typeof data.attendance!=='object'||!Array.isArray(data.weeks))throw new Error('format');if(!confirm('Importer cette sauvegarde remplacera les données actuellement enregistrées sur cet appareil. Continuer ?'))return;sessions=data.sessions;people=data.people;attendance=data.attendance;weeks=[...new Set(data.weeks)].sort();selectedWeek=weeks.includes(data.selectedWeek)?data.selectedWeek:weeks[0];save();persistWeeks();active=sessions[0]?.id||null;render()}catch(err){alert('Impossible d’importer cette sauvegarde. Vérifiez qu’il s’agit bien d’un fichier JSON exporté par cette application.')}finally{e.target.value=''}};reader.readAsText(file)};$('addPerson').onclick=()=>openPerson();$('addException').onclick=openException;$('exceptionForm').addEventListener('submit',e=>{const submitter=(e.submitter||document.activeElement);if(submitter&&submitter.value==='cancel')return;let pid=+$('exceptionPerson').value;if(!pid){e.preventDefault();return}let k=key(active,pid);if(attendance[k]){e.preventDefault();return alert('Ce participant est déjà ajouté à cette séance.')}attendance[k]='exceptional';save();render()});$('addSession').onclick=()=>openSession();$('profileSelect').onchange=renderTracking;$('week').onchange=()=>{selectedWeek=$('week').value;render()};$('addWeek').onclick=()=>{let raw=prompt('Date du lundi de la nouvelle semaine (AAAA-MM-JJ) :',selectedWeek);if(raw===null)return;raw=raw.trim();if(!/^\d{4}-\d{2}-\d{2}$/.test(raw))return alert('Format invalide. Utilisez AAAA-MM-JJ.');let d=new Date(raw+'T12:00:00');if(Number.isNaN(d.getTime()))return alert('Date invalide.');let mondayDate=monday(d);if(iso(mondayDate)!==raw)return alert('La date doit être un lundi.');if(weeks.includes(raw))return alert('Cette semaine existe déjà.');weeks.push(raw);selectedWeek=raw;persistWeeks();render()};$('deleteWeek').onclick=()=>{if(weeks.length<=1)return alert('Conservez au moins une semaine.');let w=$('week').value;if(!confirm(`Supprimer la semaine du ${fmt(new Date(w+'T12:00:00'))} et tous ses pointages ?`))return;weeks=weeks.filter(x=>x!==w);Object.keys(attendance).filter(k=>k.startsWith(w+'|')).forEach(k=>delete attendance[k]);selectedWeek=weeks[0];persistWeeks();save();render()};$('clearWeek').onclick=()=>{if(confirm('Réinitialiser tous les pointages de cette semaine ?')){Object.keys(attendance).filter(k=>k.startsWith($('week').value+'|')).forEach(k=>delete attendance[k]);save();render()}};document.querySelectorAll('[data-tab]').forEach(t=>t.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.setAttribute('aria-selected',x===t));document.querySelectorAll('.panel').forEach(x=>x.classList.toggle('active',x.id===t.dataset.tab));render()});function render(){renderSessions();renderPointing();renderTracking();renderSettings()}save();render();document.querySelectorAll('dialog .button[value="cancel"]').forEach(btn=>{btn.addEventListener('click',e=>{const dlg=btn.closest('dialog');if(dlg){e.preventDefault();closeDialog(dlg);}});});
</script></body></html>
